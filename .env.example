# Supabase project settings > API (or the values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Used by newsletter actions and maintenance scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
